rules_version = '2';

// 교사가 학급별 마스코트/스티커 이미지를 올리는 용도. 파일은 누구나(학생 포함) 볼 수 있어야
// 체크인 화면에 뜨므로 읽기는 공개, 쓰기는 그 학급의 담임교사(경로의 {classId} == 로그인한
// 사용자 uid)만 가능하도록 제한한다.
service firebase.storage {
  match /b/{bucket}/o {
    match /classes/{classId}/mascot/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == classId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
